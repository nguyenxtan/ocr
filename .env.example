TELEGRAM_BOT_TOKEN=PASTE_YOUR_TOKEN_HERE
# PUBLIC: anyone may send a PDF in a private chat with this bot.
# PRIVATE: only Telegram IDs listed below may use the bot.
BOT_ACCESS_MODE=PUBLIC
# Used only when BOT_ACCESS_MODE=PRIVATE (comma-separated numeric user IDs).
ALLOWED_USER_IDS=
MAX_PDF_MB=15
MAX_PAGES=10
OCR_LANG=vie+eng
PROCESS_TIMEOUT_SEC=90
MAX_CONCURRENT_PDFS=1
# Up to 3 extra PDFs wait instead of immediately reporting the bot is busy.
MAX_QUEUED_PDFS=3
QUEUE_WAIT_SEC=300
# Optional proof photos never delay/cancel the main OCR verdict by more than this.
EVIDENCE_TIMEOUT_SEC=15
USER_COOLDOWN_SEC=10
WORKER_CPU_SECONDS=90

# Total optional Paddle network time per PDF (seconds); 0 disables optional calls.
# This caps existing PADDLE_TIMEOUT_SEC, including the Compose value of 18.
PADDLE_BUDGET_SEC=8
# Run identical signatory OCR for at most two pages together. Use 1 on a single-core host.
SIGNER_OCR_WORKERS=2
