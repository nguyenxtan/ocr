FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    PADDLE_PDX_MODEL_SOURCE=BOS \
    PADDLE_PDX_CACHE_HOME=/models

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 libglib2.0-0 libgl1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir --upgrade pip \
 && python -m pip install --no-cache-dir paddlepaddle==3.2.0 \
 && python -m pip install --no-cache-dir paddleocr==3.7.0
WORKDIR /app
COPY app/__init__.py app/paddle_service.py app/paddle_contract.py ./app/
RUN useradd --uid 10002 --create-home --shell /usr/sbin/nologin paddlebot \
    && mkdir -p /models && chown paddlebot:paddlebot /models
USER paddlebot
EXPOSE 8877
CMD ["python", "-m", "app.paddle_service"]
